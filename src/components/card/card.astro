---
const { src, name, description, season } = Astro.props;
---

<div class="group relative overflow-hidden rounded-md bg-white">
  <div class="overflow-hidden">
    <img
      src={src}
      class="transition-transform duration-700 group-hover:scale-110"
    />
  </div>
  <div class="flex flex-col gap-2 px-6 py-6">
    <h3>{name}</h3>
    <p class="type-body-md">{description}</p>
    <a href="#contact" class="type-label-sm">Zapytaj o dostępność</a>
  </div>
  <div class="absolute top-3 left-3 rounded-lg bg-white px-4 py-1">
    {season}
  </div>
</div>
