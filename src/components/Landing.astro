---
import { copy, contact, type Locale } from '../content/site';
import '../styles/global.css';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const sections = ['pracownia', 'miody', 'faq', 'kontakt'];
const site = Astro.site;
const canonical = site ? new URL(locale === 'pl' ? '/' : '/en/', site) : undefined;
const meta = site ? { '@context': 'https://schema.org', '@type': 'Organization', name: 'Pracownia Pszczelarska REIL', url: site.href, ...(contact.phone ? { telephone: contact.phone } : {}), ...(contact.email ? { email: contact.email } : {}), ...(contact.address ? { address: contact.address } : {}) } : undefined;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f2e9" />
    <meta name="description" content={t.description} />
    <meta name="generator" content={Astro.generator} />
    <title>{t.title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/assets/fonts/PTSerif-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/PTSerif-Italic.woff2" as="font" type="font/woff2" crossorigin />
    {canonical && <link rel="canonical" href={canonical} />}
    {site && <>
      <link rel="alternate" hreflang="pl" href={new URL('/', site)} />
      <link rel="alternate" hreflang="en" href={new URL('/en/', site)} />
      <link rel="alternate" hreflang="x-default" href={new URL('/', site)} />
      <meta property="og:url" content={canonical} />
      <meta property="og:image" content={new URL('/og-image.png', site)} />
    </>}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="REIL" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:locale" content={locale === 'pl' ? 'pl_PL' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    {meta && <script is:inline type="application/ld+json" set:html={JSON.stringify(meta).replace(/</g, '\u003c')} />}
    <script is:inline>
      try {
        const theme = localStorage.getItem('reil-theme');
        document.documentElement.dataset.theme = theme === 'light' || theme === 'dark' ? theme : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch { document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header wrap">
      <a href={locale === 'pl' ? '/' : '/en/'} class="brand" aria-label={`REIL — ${t.craft}`}>REIL<span class="brand-dot">.</span></a>
      <nav aria-label={locale === 'pl' ? 'Nawigacja główna' : 'Main navigation'}>
        {sections.map((id, i) => <a href={`#${id}`}>{t.nav[i]}</a>)}
      </nav>
      <div class="header-tools">
        <div class="languages" aria-label={locale === 'pl' ? 'Język' : 'Language'}>
          <a href="/" lang="pl" hreflang="pl" aria-current={locale === 'pl' ? 'page' : undefined}>PL</a>
          <span aria-hidden="true">/</span><a href="/en/" lang="en" hreflang="en" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
        </div>
        <button class="icon-button theme-button" aria-label={t.theme} aria-pressed="false" hidden title={t.theme}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.6 13.2A9 9 0 0 1 10.8 3.4 9 9 0 1 0 20.6 13.2Z" /></svg>
        </button>
        <button class="icon-button motion-button" aria-label={t.motion} aria-pressed="true" hidden title={t.motion}>
          <svg class="pause-icon" width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M5 4h3v12H5zm7 0h3v12h-3z" /></svg>
          <svg class="play-icon" width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="m6 3 11 7-11 7z" /></svg>
        </button>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <div class="opening">
        <section class="hero wrap" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="tiny-flower" aria-hidden="true">✳</span> {t.craft}</p>
            <h1 id="hero-title"><span>{t.heroTop}</span>{t.heroMain}<br /><em>{t.heroItalic}</em></h1>
            <p class="hero-intro">{t.intro}</p>
            <a class="button-primary" href="#miody">{t.discover}<span aria-hidden="true">↗</span></a>
          </div>
          <div class="hero-art">
            <div class="hero-disc" aria-hidden="true"></div>
            <div class="static-jar" aria-hidden="true"><div class="jar-lid"></div><div class="jar-glass"><div class="jar-label"><span>{t.craft}</span><b>REIL.</b><span>{t.jarCaption}</span></div></div></div>
            <div class="hero-orbit" aria-hidden="true"><span>✳</span></div>
            <button class="jar-control" type="button" aria-label={t.jarControl} aria-keyshortcuts="ArrowLeft ArrowRight Home" hidden></button>
          </div>
        </section>

        <section class="story wrap" id="pracownia" aria-labelledby="story-title">
          <div class="story-marker"><p class="eyebrow">{t.storyLabel}</p><div class="flower-mark" aria-hidden="true">✳</div></div>
          <div class="story-copy"><h2 id="story-title">{t.storyTitle}<br /><em>{t.storyItalic}</em></h2><p>{t.storyText}</p><p class="story-foot">{t.storyFoot}</p></div>
        </section>
        <div id="scene" class="scene" aria-hidden="true"></div>
      </div>

      <section class="products-section" id="miody" aria-labelledby="products-title">
        <div class="wrap">
          <div class="section-heading"><div><p class="eyebrow">{t.offerLabel}</p><h2 id="products-title">{t.offerTitle}</h2></div><p>{t.offerIntro}</p></div>
          <div class="products-grid">
            {t.products.map((product) => <article class="product-card">
              <a class="product-image-link" href={`#details-${product.id}`} data-product={product.id} aria-label={`${t.details}: ${product.name} — ${product.season}`}>
                <div class="product-image"><img src={`/assets/images/${product.id}.webp`} alt={`${locale === 'pl' ? 'Słoik miodu' : 'A jar of honey'} — ${product.name}`} width="1184" height="864" loading="lazy" decoding="async" /><span class="harvest-season">{product.season}</span><span class="image-arrow" aria-hidden="true">↗</span></div>
              </a>
              <div class="product-heading"><h3><a href={`#details-${product.id}`} data-product={product.id}>{product.name}</a></h3><span aria-hidden="true">✳</span></div>
              <p class="product-note">{product.note}</p>
              <a class="ask-link" href="#kontakt">{t.ask}<span aria-hidden="true">↗</span></a>
              <details id={`details-${product.id}`} class="product-fallback">
                <summary>{t.details}</summary>
                <div class="product-detail-content" data-detail={product.id}>
                  <p class="detail-intro">{product.description}</p>
                  <dl>{[[t.taste, product.taste], [t.use, product.use], [t.crystallization, product.crystallization]].map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
                </div>
              </details>
            </article>)}
            <div class="collection-note"><span class="collection-flower" aria-hidden="true">✳</span><p>{locale === 'pl' ? 'Nie musisz wybierać od razu.' : 'No need to choose just yet.'}</p><a href="#kontakt">{locale === 'pl' ? 'Porozmawiajmy o smakach' : 'Let’s talk about flavours'} <span aria-hidden="true">↗</span></a></div>
          </div>
          <p class="draft-note">{t.draftProducts}</p>
        </div>
      </section>

      <section class="faq-section wrap" id="faq" aria-labelledby="faq-title">
        <div class="faq-heading"><p class="eyebrow">{t.faqLabel}</p><h2 id="faq-title">{t.faqTitle}</h2><p>{t.faqIntro}</p><span class="faq-flower" aria-hidden="true">✳</span></div>
        <div class="faq-list">{t.faq.map((item, index) => <details><summary><span class="faq-number">0{index + 1}</span><h3>{item.q}</h3><span class="faq-toggle" aria-hidden="true">+</span></summary><p>{item.a}</p></details>)}</div>
      </section>

      <section class="contact-section" id="kontakt" aria-labelledby="contact-title"><div class="wrap">
        <p class="eyebrow">{t.contactLabel}</p>
        <div class="contact-heading"><h2 id="contact-title">{t.contactTitle}<br /><em>{t.contactItalic}</em></h2><span class="contact-flower" aria-hidden="true">✳</span></div>
        <p class="contact-intro">{t.contactIntro}</p>
        <div class="contact-grid">
          <div><span class="contact-label">01 / {t.phone}</span>{contact.phone ? <a href={`tel:${contact.phone.replace(/[^+\d]/g, '')}`}>{contact.phone} ↗</a> : <p>{t.pending}</p>}</div>
          <div><span class="contact-label">02 / {t.email}</span>{contact.email ? <a href={`mailto:${contact.email}`}>{contact.email} ↗</a> : <p>{t.pending}</p>}</div>
          <div><span class="contact-label">03 / {t.address}</span>{contact.address ? <address>{contact.address}</address> : <p>{t.pending}</p>}</div>
        </div>
        {Object.values(contact).some(value => !value) && <p class="contact-draft">{t.draft}</p>}
      </div></section>
    </main>
    <footer class="site-footer wrap"><div class="footer-top"><span>{t.craft}</span><span>{t.footer}</span><a href="#main">{t.back} ↑</a></div><div class="footer-wordmark" aria-hidden="true">REIL<span>.</span></div><div class="footer-bottom"><span>© {new Date().getFullYear()} REIL</span><span>{locale === 'pl' ? 'Z uważnością dla małych rzeczy.' : 'With care for the little things.'}</span></div></footer>

    <dialog id="product-dialog" aria-labelledby="dialog-title">
      <button class="dialog-close icon-button" aria-label={t.close}>×</button>
      <div class="dialog-layout"><img id="dialog-image" src="/assets/images/wielokwiat.webp" alt="" width="1184" height="864" loading="lazy" /><div class="dialog-copy"><p class="eyebrow">REIL / {t.nav[1]}</p><h2 id="dialog-title"></h2><div id="dialog-content"></div></div></div>
    </dialog>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
