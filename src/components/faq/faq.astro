---
import faq from "./faq.json";
const locale = Astro.currentLocale;
---

<section class="flex flex-col gap-4 py-4">
  <h2 class="type-headline-lg w-full text-center">FAQ</h2>
  {
    faq.map((item) => (
      <details class="group border-b border-[var(--color-divider)] [&:first-of-type]:border-t">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-[var(--color-secondary)] transition-colors duration-200 select-none group-open:text-[var(--color-primary)] focus-visible:rounded focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-primary)] [&::-webkit-details-marker]:hidden">
          <span class="text-[1.05rem] leading-snug font-medium tracking-tight transition-colors duration-200 group-open:text-[var(--color-primary)]">
            {item[locale].question}
          </span>
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[var(--color-divider)] text-[var(--color-primary)] transition-colors duration-200 group-open:border-[var(--color-primary)]/40 group-open:bg-[var(--color-primary)]/10">
            <svg
              class="block transition-transform duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-open:-rotate-180"
              width="18"
              height="18"
              viewBox="0 0 18 18"
              fill="none"
            >
              <polyline
                points="3,6 9,12 15,6"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </summary>

        <div>
          <div class="min-h-0 overflow-hidden">
            <div class="pb-6">
              <p class="max-w-[68ch] text-[0.95rem] leading-7 text-[var(--color-on-surface-muted)]">
                {item[locale].answer}
              </p>
            </div>
          </div>
        </div>
      </details>
    ))
  }
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .css-item * {
      transition: none !important;
    }
  }
</style>
