---
import { useTranslations } from "../../i18n/layout.ts";
const locale = Astro.currentLocale;
const i18n = useTranslations(locale);
---

<footer
  class="flex w-full flex-col justify-between bg-[linear-gradient(to_bottom,#FFEAD0_0%,oklch(0.8995_0.0567_73.93)_99%,#FFEAD0_100%)] py-4 md:flex-row"
>
  <a class="type-body-sm" href={locale === "en" ? "/en" : "/"}>
    {i18n.header.main} REIL
  </a>
  <p class="type-body-sm">
    &copy; {new Date().getFullYear()}
    {i18n.header.main} REIL. Stary Żagań
  </p>
</footer>
