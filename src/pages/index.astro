---
import Layout from "../layouts/main.astro";
import honeys from "../data/honeys.json";
import Card from "../components/card/card.astro";
import Faq from "../components/faq/faq.astro";

import { useTranslations } from "../i18n/layout.ts";
const locale = Astro.currentLocale;
---

<Layout>
  <section id="hero" class="d-flex relative w-full flex-col">
    <div
      id="model-container"
      class="sticky inset-0 top-0 z-1 h-[100svh] w-full"
    >
      <canvas id="three-canvas" class="h-full w-full"></canvas>
    </div>
    <div
      id="transition-move"
      class="relative mt-[-100svh] flex h-[80svh] w-full flex-col"
    >
      <div class="clip-text">
        <h1
          class="hero-title font-display-xl text-display-xl flex flex-col leading-[0.9] text-(--color-secondary)"
        >
          <div class="overflow-hidden py-2">
            <span class="inline-block translate-y-full opacity-0"
              >Prawdziwy</span
            >
          </div>
          <div class="overflow-hidden md:pl-[15%]">
            <span
              t
              class="accent-word inline-block translate-y-full text-(--color-primary) italic opacity-0"
              >Smak</span
            >
          </div>
          <div class="overflow-hidden py-2">
            <span class="inline-block translate-y-full opacity-0">Natury</span>
          </div>
        </h1>
      </div>

      <div
        class="lg:mt-xl mb-xl relative z-2 mt-[5svh] mt-auto w-full md:mt-[15svh] lg:mt-0 lg:mb-0 lg:ml-auto lg:w-1/2"
      >
        <div class="hero-description translate-y-8 opacity-0">
          <p
            class="text-on-surface-muted mb-sm lg:text-quote lg:mb-xl pl-lg py-xs md:text-revert border-l-2 border-(--color-primary) text-lg md:text-[38px]"
          >
            Miód, który sami chcielibyśmy kupować. Z pasieki w Starym Żaganiu,
            gdzie tradycja spotyka czystość.
          </p>
          <div class="gap-md flex flex-col flex-wrap md:flex-row">
            <a
              class="hero-btn group text-surface font-label-lg px-xl h-touch-target inline-flex cursor-pointer items-center justify-center overflow-hidden rounded-full bg-(--color-secondary) transition-all duration-300 hover:scale-[1.03] hover:bg-black"
              href="#honeys"
            >
              <span class="relative z-10 px-[1ch]">Poznaj miody</span>
              <span
                class="absolute right-4 -translate-x-2 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100"
                >→</span
              >
            </a>
            <a
              class="hero-btn-alt font-label-lg px-xl h-touch-target inline-flex cursor-pointer items-center justify-center rounded-full border border-(--color-secondary)/20 text-(--color-secondary) transition-all hover:scale-[1.03] hover:bg-(--color-secondary)/10"
              href="#contact"
            >
              Kontakt
            </a>
          </div>
        </div>
      </div>

      <div
        class="lg:bottom-xl gap-xs mt-auto flex flex-col items-center opacity-0"
        id="scroll-indicator"
      >
        <span
          class="font-label-sm text-[10px] tracking-widest text-(--color-secondary)/40 uppercase"
          >Przewiń</span
        >
        <div
          class="h-12 w-[1px] origin-top bg-gradient-to-b from-(--color-primary) to-transparent"
          id="scroll-line"
        >
        </div>
      </div>
    </div>

    <div
      id="bees-container"
      class="sticky top-[15svh] z-2 mt-auto h-[100svh] w-full"
    >
      <canvas id="bees-canvas" class="h-full w-full"></canvas>
    </div>

    <div class="glb-anim flex h-[200svh] w-full justify-end"></div>
  </section>
  <section
    id="history"
    class="flex flex-col items-center gap-(--spacing-grid-gap) bg-[linear-gradient(to_bottom,#FFEAD0_0%,oklch(0.8995_0.0567_73.93)_50%,#FFEAD0_100%)] py-4 text-center md:flex-row md:text-left"
  >
    <div class="w-full md:w-2/3 lg:w-1/2">
      <img
        class="max-h-[80svh] w-full object-contain"
        alt="Pszczelarz oglądający swoje pszczoły"
        src="https://images.unsplash.com/photo-1602867693070-f9db4f42463a?q=80&w=688&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
      />
    </div>
    <div class="flex w-full flex-col gap-[1lh] lg:w-1/2">
      <h1 class="text-headline-lg">Z szacunku do tradycji.</h1>
      <p class="type-body-md">
        Nasza historia zaczyna się w Starym Żaganiu, gdzie czas płynie w rytmie
        wyznaczanym przez pory roku. Atelier Pszczelarskie REIL to nie tylko
        pasieka, to rodzinne dziedzictwo, pielęgnowanie przez pokoleń.
      </p>
      <p class="type-body-md">
        Wierzymy, że najlepszy miód to ten, w który włożono serce i czas. Nie
        przyspieszamy procesów. Pozwalamy naturze wykonać swoją pracę, a jedynie
        z pokorą odbieramy to, co ma nam do zaoferowania. Nasze ule stoją wśród
        dzikich łąk i starych lasów, i na poligonach wojskowych.
      </p>
    </div>
  </section>
  <section
    class="flex flex-col items-center gap-4 py-4 text-center"
    id="honeys"
  >
    <h1 class="text-headline-lg">Dary natury</h1>
    <p class="type-body-md w-full lg:w-1/2">
      Każdy słoik miodu to zapis chwili, konkretnego miejsca, pogody i
      kwitnących roślin. Oferujemy wyłącznie miody surowe, niedosładzane,
      nierozgrzewane i niefiltrowane mechanicznie.
    </p>
    <div
      class="mt-4 grid w-full grid-cols-1 gap-x-4 gap-y-4 md:grid-cols-2 lg:grid-cols-3"
    >
      {
        honeys.map((honey) => (
          <Card
            name={honey[locale].name}
            season={honey[locale].season}
            description={honey[locale].description}
            alt={honey[locale].alt}
            src={honey.src}
          />
        ))
      }
    </div>
  </section>
  <Faq />
  <section
    class="flex flex-row items-center gap-(--spacing-grid-gap) bg-[linear-gradient(to_bottom,#FFEAD0_0%,oklch(0.8995_0.0567_73.93)_50%,#FFEAD0_100%)] py-4"
    id="contact"
  >
    <div class="flex w-full flex-col gap-4 md:w-3/5 lg:w-2/5">
      <h1 class="text-headline-md">Porozmawiajmy.</h1>
      <p class="text-body-md">
        Chcesz zapytać o dostępność miodów z ostatnich zbiorów? Zapraszamy do
        kontaktu bezpośredniego. Każda partia miodu jest limitowana.
      </p>
      <div class="type-label-sm flex flex-col gap-[0.2lh]">
        E-mail
        <a
          href="mailto:kontakt@atelier-reil.pl"
          class="type-body-md cursor-pointer">kontakt@atelier-reil.pl</a
        >
      </div>
      <div class="type-label-sm flex flex-col gap-[0.2lh]">
        Telefon
        <a href="tel:+48123456789" class="type-body-md cursor-pointer"
          >+48 123 456 789</a
        >
      </div>
      <div class="type-label-sm flex flex-col gap-[0.2lh]">
        Adres Pasieki
        <a
          href="https://maps.app.goo.gl/1uE1pBjqV8oyk2mbA"
          target="_blank"
          rel="nofollow noopener"
          class="type-body-md cursor-pointer">Stary Żagań, Polska</a
        >
      </div>
    </div>
  </section>
</Layout>

<script src="../scripts/gsap.js"></script>
<script src="../scripts/bees.js"></script>
<script src="../scripts/jar.js"></script>
